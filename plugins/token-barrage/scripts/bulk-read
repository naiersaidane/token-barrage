#!/bin/bash
# Délègue une lecture de fichiers au worker.
# Usage : bulk-read --question "que fait ce service ?" --paths a.ts b.ts
#
# Interface volontairement identique à celle de shunt, pour que le banc de
# mesure compare les deux implémentations à variables égales.

. "$(cd "$(dirname "$0")" && pwd)/lib/worker.sh"

question=""
paths=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --question) question="$2"; shift 2 ;;
    --paths)    shift; while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do paths+=("$1"); shift; done ;;
    *)          shift ;;
  esac
done

[ -z "$question" ]     && { echo "Erreur : --question est requis" >&2; exit 1; }
[ ${#paths[@]} -eq 0 ] && { echo "Erreur : --paths est requis" >&2; exit 1; }

# Un chemin fautif partirait en bloc <file> vide et produirait une réponse
# assurée sur du néant. Mieux vaut échouer bruyamment.
for path in "${paths[@]}"; do
  if [ ! -f "$path" ] || [ ! -r "$path" ]; then
    echo "Erreur : fichier introuvable ou illisible : $path" >&2
    exit 1
  fi
done

barrage_preflight || exit 1
barrage_tmpfile message_file || exit 1

# Chaque fichier est encadré par des balises XML : frontières nettes pour le
# modèle. On écrit directement dans le fichier, sans variable shell de la
# taille du corpus, pour que le contenu survive octet pour octet.
for path in "${paths[@]}"; do
  {
    printf '<file path="%s">\n' "$path"
    cat "$path"
    printf '</file>\n\n'
  } >> "$message_file"
done
printf 'Question: %s\n' "$question" >> "$message_file"

barrage_invoke "bulk-reader" "$message_file" || exit 1
